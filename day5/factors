#include<stdio.h>
//wap to print factors of a given number
int main(){
    int n,i;
    printf("enter the number :");
    scanf("%d",&n);
    printf("factors of %d are :",n);
    for (i=1;i<=n;i++){
        if(n%i==0){
            printf("%d\n",i);
    
        }
    }
    return 0;
}
