#include<stdio.h>
//wap to recursive sum of digits
int sum(int n)
{
    if(n==0){
        return 0;
    }
    else{
        return n%10  + sum(n/10);
    
    }
}
int main(){
    int n;
    printf("enter the number :");
    scanf("%d",&n);
    printf("sum of digitd of %d is %d",n,sum(n));
    return 0;
}