#include<stdio.h>
#include<math.h>
//wap to recursive reverse number
int rev(int n){
    if(n==0){
        return 0;
    }
    else{
        return (n%10 * pow(10, (int)log10(n))) + rev(n/10);
    }
}
int main(){
    int n;
    printf("enter the number :");
    scanf("%d",&n);
    printf("reverse of %d is %d",n,rev(n));
    return 0;
}