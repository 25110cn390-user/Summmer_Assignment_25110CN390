#include<stdio.h>
//wap to recursive fibonacci
int fib(int n){
    if(n==0){
        return 0;
    }
    else if(n==1){
        return 1;
    }
    else{
        return fib(n-1)+fib(n-2);

    }
}
int main(){
    int n;
    printf("enter the number:");
    scanf("%d",&n);
    printf("the fibonacci  series of %d is %d",n,fib(n));
    return 0;
}