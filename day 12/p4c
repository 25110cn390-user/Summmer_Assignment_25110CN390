#include<stdio.h>
//wap to make fuction of perfect number
int perfect(int n){
    int sum=0;
    for(int i=1;i<n;i++){
        if(n%i==0){
            sum=sum+i;
        }
    }
    if(sum==n){
        return 1; //perfect
    }
    else{
        return 0; //not perfect
    }
}
int main(){
    int num;
    printf("Enter a number: ");
    scanf("%d",&num);
    if(perfect(num)){
        printf("%d is a perfect number.",num);
    }
    else{
        printf("%d is not a perfect number.",num);
    }
    return 0;
}